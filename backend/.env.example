# =================================================================
# IPL AUCTION ARENA - BACKEND CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your real values.
# NEVER commit the real .env file with active credentials to Git!
# =================================================================

# Node Environment: 'production' for live cloud deployment, 'development' for local
NODE_ENV=production

# Server Port (Cloud platforms like Render/Railway automatically inject PORT)
PORT=5000

# MongoDB Atlas Production Connection String
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ipl_auction_arena?retryWrites=true&w=majority

# Local MongoDB URI (Only used in development/test when Atlas is unreachable)
# In production (NODE_ENV=production), local fallback is strictly disabled.
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/ipl_auction_arena

# JWT & Session Secret (Generate a strong random 256-bit string for production)
JWT_SECRET=replace_with_strong_cryptographic_random_secret_minimum_32_chars

# Allowed Frontend Origins (For CORS and Socket.IO validation)
CLIENT_URL=https://ipl-auction-arena.onrender.com
FRONTEND_URL=https://ipl-auction-arena.onrender.com
